@startuml
hide methods
skinparam classAttributeIconSize 0
class UserEntity { id: UUID\nusername: String\ndisplayName: String\navatarStorageKey: String? }
class FriendshipEntity { id: UUID\nuserId: UUID\nfriendId: UUID\nstatus: FriendshipStatus }
class GroupEntity { id: UUID\nname: String\nstatus: GroupStatus\navatarStorageKey: String? }
class GroupMembershipEntity { id: UUID\nrole: GroupRole\nstatus: GroupMembershipStatus }
class GroupInviteLinkEntity { id: UUID\ncode: String\nisRevoked: boolean }
class GroupBanEntity { id: UUID\nuserId: UUID }
class GroupActivityLogEntity { id: UUID\nactorUserId: UUID\naction: GroupActivityAction }
class ActivityEntity { id: UUID\nstatus: ActivityStatus\nstartAt: Instant?\nendAt: Instant?\ntimezone: String?\ncapacity: Integer? }
class ActivityParticipantEntity { id: UUID\nrsvpStatus: ActivityRsvpStatus\nwaitlistSequence: Long? }
class ActivityWaitlistSequenceEntity { activityId: UUID\ncurrentSequence: Long }
class PollEntity { id: UUID\nactivityId: UUID\ncreatedBy: UUID\nstatus: PollStatus }
class PollOptionEntity { id: UUID\npollId: UUID\nisDisabled: boolean }
class PollVoteEntity { id: UUID\npollId: UUID\nuserId: UUID }
class PollVoteChoiceEntity { voteId: UUID\noptionId: UUID }
class TaskEntity { id: UUID\nactivityId: UUID\ncreatedBy: UUID\nstatus: TaskStatus }
class TaskAssigneeEntity { taskId: UUID\nuserId: UUID }
class TaskStatusHistoryEntity { taskId: UUID\nfromStatus: TaskStatus?\ntoStatus: TaskStatus }
class ActivityCommentEntity { id: UUID\nactivityId: UUID\nauthorId: UUID\nparentCommentId: UUID?\nisDeleted: boolean }
class ConversationEntity { id: UUID\ntype: DIRECT | GROUP\ncreatedAt: Instant\nupdatedAt: Instant }
class DirectConversationEntity { conversationId: UUID\nuserId1: UUID\nuserId2: UUID }
class GroupConversationEntity { conversationId: UUID\ngroupId: UUID }
class ConversationSequenceEntity { conversationId: UUID\ncurrentSequence: long }
class MessageRequestEntity { id: UUID\nsenderId: UUID\nreceiverId: UUID\nstatus: RequestStatus\nresolvedAt: Instant? }
class MessageEntity { id: UUID\nsequence: long\nsenderId: UUID?\ntype: TEXT | IMAGE\ncontent: String?\nstatus: ACTIVE | UNSENT\nreplyToMessageId: UUID? }
class MessageAttachmentEntity { id: UUID\nstorageKey: String\ncontentType: String\nfileSizeBytes: long\nsortOrder: int }
class MessageEditHistoryEntity { id: UUID\npreviousContent: String?\neditedAt: Instant }
class MessageHiddenUserEntity { messageId: UUID\nuserId: UUID\nhiddenAt: Instant }
class MessageReactionEntity { id: UUID\nmessageId: UUID\nuserId: UUID\nemoji: String }
class ConversationReadStateEntity { conversationId: UUID\nuserId: UUID\nlastReadSequence: long }
class MessagePinEntity { id: UUID\nmessageId: UUID\npinnedBy: UUID? }
class ExpenseController
class ExpenseService
class ExpenseRequest { title: String\namount: BigDecimal\npayerUserId: UUID\nsplitMethod: EQUAL | CUSTOM_AMOUNT\nparticipantUserIds: UUID[]?\nshares: ShareRequest[]?\nactivityId: UUID?\noccurredAt: OffsetDateTime }
class ExpenseDetail { id: UUID\namount: BigDecimal\nstatus: ACTIVE | CANCELLED\nshares: Share[]\nchangeHistory: Change[]\npermissions: PermissionProjection }
class MyBalances { totalOwedByMe: BigDecimal\ntotalOwedToMe: BigDecimal\nbalances: UserBalance[] }
class CreateSettlementRequest { otherUserId: UUID\namount: BigDecimal\ndeclarationType: I_PAID | I_RECEIVED }
class SettlementResponse { id: UUID\ngroupId: UUID\nfromUser: UserSummary\ntoUser: UserSummary\namount: BigDecimal\nstatus: PENDING | COMPLETED | REJECTED | CANCELLED\ndeclarationType: I_PAID | I_RECEIVED\nstatusHistory: SettlementStatusChange[]\npermissions: SettlementPermissionProjection }
class FundController
class FundService
class FundDetailResponse { fundId: UUID\ngroupId: UUID\nname: String\ncurrency: String\nstatus: ACTIVE | CLOSED\nledgerBalance: BigDecimal\navailableBalance: BigDecimal\npendingReimbursementsAmount: BigDecimal\nmanagers: FundManagerResponse[] }
class CollectionDetailResponse { collectionId: UUID\nfundId: UUID\ntitle: String\nstatus: OPEN | CLOSED | CANCELLED\nobligations: CollectionObligationResponse[]\ncontributions: ContributionResponse[] }
class FundExpenseResponse { expenseId: UUID\nfundId: UUID\ntitle: String\namount: BigDecimal\ntransactionId: UUID\nreversed: boolean }
class ReimbursementResponse { reimbursementId: UUID\nfundId: UUID\namount: BigDecimal\nstatus: PENDING | COMPLETED | REJECTED | CANCELLED\ntransactionId: UUID?\nreversed: boolean }
class FundTransactionResponse { transactionId: UUID\nfundId: UUID\ntransactionType: CONTRIBUTION | FUND_EXPENSE | REIMBURSEMENT | REVERSAL\ndirection: IN | OUT\namount: BigDecimal\nreversed: boolean\noriginalTransactionId: UUID? }
UserEntity "1" -- "0..*" GroupMembershipEntity
GroupEntity "1" -- "0..*" GroupMembershipEntity
GroupEntity "1" -- "0..*" GroupInviteLinkEntity
