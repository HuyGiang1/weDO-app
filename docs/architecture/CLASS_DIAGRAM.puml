class PollEntity { id: UUID\ngroupId: UUID\nactivityId: UUID?\ncreatedBy: UUID\nstatus: PollStatus }
class PollOptionEntity { id: UUID\npollId: UUID\nisDisabled: boolean }
class PollVoteEntity { id: UUID\npollId: UUID\nuserId: UUID }
class PollVoteChoiceEntity { voteId: UUID\noptionId: UUID }
