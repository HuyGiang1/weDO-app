class GroupConversationEntity { conversationId: UUID\ngroupId: UUID }
class ConversationSequenceEntity { conversationId: UUID\ncurrentSequence: long }
class MessageRequestEntity { id: UUID\nsenderId: UUID\nreceiverId: UUID\nstatus: RequestStatus\nresolvedAt: Instant? }
class MessageEntity { id: UUID\nsequence: long\nsenderId: UUID?\ntype: TEXT | IMAGE | POLL | POLL_VOTED | POLL_VOTE_CHANGED\ncontent: String?\npollId: UUID?\nstatus: ACTIVE | UNSENT\nreplyToMessageId: UUID? }
class MessageAttachmentEntity { id: UUID\nstorageKey: String\ncontentType: String\nfileSizeBytes: long\nsortOrder: int }
class MessageEditHistoryEntity { id: UUID\npreviousContent: String?\neditedAt: Instant }
class MessageHiddenUserEntity { messageId: UUID\nuserId: UUID\nhiddenAt: Instant }
class MessageReactionEntity { id: UUID\nmessageId: UUID\nuserId: UUID\nemoji: String }
class ConversationReadStateEntity { conversationId: UUID\nuserId: UUID\nlastReadSequence: long }
class MessagePinEntity { id: UUID\nmessageId: UUID\npinnedBy: UUID? }
class ExpenseController
class ExpenseService
class ExpenseRequest { title: String\namount: BigDecimal\npayerUserId: UUID\nsplitMethod: EQUAL | CUSTOM_AMOUNT\nparticipantUserIds: UUID[]?\nshares: ShareRequest[]?\nactivityId: UUID?\noccurredAt: OffsetDateTime }
class ExpenseDetail { id: UUID\namount: BigDecimal\nstatus: ACTIVE | CANCELLED\nshares: Share[]\nchangeHistory: Change[]\npermissions: PermissionProjection }
class MyBalances { totalOwedByMe: BigDecimal\ntotalOwedToMe: BigDecimal\nbalances: UserBalance[] }
class CreateSettlementRequest { otherUserId: UUID\namount: BigDecimal\ndeclarationType: I_PAID | I_RECEIVED }
class SettlementResponse { id: UUID\ngroupId: UUID\nfromUser: UserSummary\ntoUser: UserSummary\namount: BigDecimal\nstatus: PENDING | COMPLETED | REJECTED | CANCELLED\ndeclarationType: I_PAID | I_RECEIVED\nstatusHistory: SettlementStatusChange[]\npermissions: SettlementPermissionProjection }
class FundController
class FundService
class FundDetailResponse { fundId: UUID\ngroupId: UUID\nname: String\ncurrency: String\nstatus: ACTIVE | CLOSED\nledgerBalance: BigDecimal\navailableBalance: BigDecimal\npendingReimbursementsAmount: BigDecimal\nmanagers: FundManagerResponse[] }
class CollectionDetailResponse { collectionId: UUID\nfundId: UUID\ntitle: String\nstatus: OPEN | CLOSED | CANCELLED\nobligations: CollectionObligationResponse[]\ncontributions: ContributionResponse[] }
class FundExpenseResponse { expenseId: UUID\nfundId: UUID\ntitle: String\namount: BigDecimal\ntransactionId: UUID\nreversed: boolean }
class ReimbursementResponse { reimbursementId: UUID\nfundId: UUID\namount: BigDecimal\nstatus: PENDING | COMPLETED | REJECTED | CANCELLED\ntransactionId: UUID?\nreversed: boolean }
class FundTransactionResponse { transactionId: UUID\nfundId: UUID\ntransactionType: CONTRIBUTION | FUND_EXPENSE | REIMBURSEMENT | REVERSAL\ndirection: IN | OUT\namount: BigDecimal\nreversed: boolean\noriginalTransactionId: UUID? }
class NotificationController
class NotificationService
class NotificationDomainEventListener
class NotificationDomainEvent { eventKey: String\neventType: String\ncategory: String\npriority: String\ncritical: boolean\nrecipientUserIds: UUID[] }
class NotificationItemResponse { notificationId: UUID\nuserId: UUID\ncategory: String\npriority: String\ncritical: boolean\nisRead: boolean\ntarget: NotificationTargetInfo\npushDecision: String }
class UserNotificationSettingsResponse { userId: UUID\npushEnabled: boolean\nsocialEnabled: boolean\ngroupEnabled: boolean\nchatEnabled: boolean\nactivityEnabled: boolean\npollEnabled: boolean\ntaskEnabled: boolean\nfinanceEnabled: boolean\nfundEnabled: boolean }
class GroupNotificationSettingsResponse { groupId: UUID\nuserId: UUID\nisMuted: boolean\nmuteDuration: String?\nmuteUntil: Instant? }
class UserDeviceResponse { id: UUID\nuserId: UUID\ndeviceId: String\nplatform: ANDROID | IOS | WEB\npushToken: String\nactive: boolean }
interface PushGateway
class FcmPushGateway
UserEntity "1" -- "0..*" GroupMembershipEntity
GroupEntity "1" -- "0..*" GroupMembershipEntity
GroupEntity "1" -- "0..*" GroupInviteLinkEntity
GroupEntity "1" -- "0..*" GroupBanEntity
GroupEntity "1" -- "0..*" GroupActivityLogEntity
GroupEntity "1" -- "0..*" ActivityEntity
ActivityEntity "1" -- "0..*" ActivityParticipantEntity
UserEntity "1" -- "0..*" ActivityParticipantEntity
ActivityEntity "1" -- "1" ActivityWaitlistSequenceEntity
ActivityEntity "1" -- "0..*" ActivityReminderEntity
UserEntity "1" -- "0..*" ActivityReminderEntity
CalendarController --> CalendarService
CalendarService --> CalendarRepository
CalendarRepository ..> CalendarActivityResponse : projects visible scheduled activities
CalendarController --> ActivityReminderEntity : reads and configures per-user reminders
ActivityReminderDeliveryScheduler --> ActivityEntity : try-locks eligible Activity first
ActivityReminderDeliveryScheduler --> ActivityReminderEntity : locks and rechecks due reminder
ActivityReminderDeliveryScheduler --> NotificationService : atomically persists inbox with sent_at
ActivityEntity "0..1" -- "0..*" PollEntity
GroupEntity "1" -- "0..*" PollEntity : canonical ownership
MessageEntity "0..1" --> "0..1" PollEntity : unique durable pollId (POLL only)
PollEntity "1" -- "2..*" PollOptionEntity
PollEntity "1" -- "0..*" PollVoteEntity
PollVoteEntity "1" -- "1..*" PollVoteChoiceEntity
PollEntity "1" -- "0..*" PollVoteCommand
PollOptionEntity "1" -- "0..*" PollVoteChoiceEntity
ActivityEntity "1" -- "0..*" TaskEntity
TaskEntity "1" -- "0..*" TaskAssigneeEntity
TaskEntity "1" -- "1..*" TaskStatusHistoryEntity
ActivityEntity "1" -- "0..*" ActivityCommentEntity
ActivityCommentEntity "0..1" -- "0..*" ActivityCommentEntity : replies
UserEntity "1" -- "0..*" FriendshipEntity
UserEntity "1" -- "0..*" ActivityCommentEntity : author
ConversationEntity "1" -- "0..1" DirectConversationEntity
ConversationEntity "1" -- "0..1" GroupConversationEntity
ConversationEntity "1" -- "1" ConversationSequenceEntity
ConversationEntity "1" -- "0..*" MessageEntity
ConversationEntity "1" -- "0..*" MessageRequestEntity
MessageEntity "1" -- "0..*" MessageAttachmentEntity
note right of MessageAttachmentEntity
  V4 schema capability.
  Upload, ownership and rendering
  are deferred beyond M9.
end note
MessageEntity "1" -- "0..*" MessageEditHistoryEntity
MessageEntity "1" -- "0..*" MessageHiddenUserEntity
MessageEntity "1" -- "0..*" MessageReactionEntity
MessageEntity "1" -- "0..1" MessagePinEntity
MessageEntity "0..1" -- "0..*" MessageEntity : replies
UserEntity "1" -- "0..*" MessageEntity : sender
ConversationEntity "1" -- "0..*" ConversationReadStateEntity
GroupEntity "1" -- "0..1" GroupConversationEntity
GroupEntity "1" -- "0..*" ExpenseDetail : groupId
GroupEntity "1" -- "0..*" SettlementResponse : groupId
GroupEntity "1" -- "0..1" FundDetailResponse : groupId
FundDetailResponse "1" -- "0..*" CollectionDetailResponse : fundId
FundDetailResponse "1" -- "0..*" FundExpenseResponse : fundId
FundDetailResponse "1" -- "0..*" ReimbursementResponse : fundId
FundDetailResponse "1" -- "0..*" FundTransactionResponse : fundId
ActivityEntity "0..1" -- "0..*" ExpenseDetail : optional activityId
ActivityEntity "0..1" -- "0..*" FundExpenseResponse : optional activityId
ExpenseController --> ExpenseService
ExpenseService ..> ExpenseRequest : validates and allocates
ExpenseService ..> ExpenseDetail : projects persisted facts
ExpenseService ..> MyBalances : derives from expenses and settlements
ExpenseService ..> CreateSettlementRequest : validates debt and pending reservations
ExpenseService ..> SettlementResponse : manages PENDING/COMPLETED/REJECTED/CANCELLED lifecycle
FundController --> FundService
FundService ..> FundDetailResponse : derives ledgerBalance and availableBalance
FundService ..> CollectionDetailResponse : manages obligations and contributions
FundService ..> FundExpenseResponse : records direct fund outflow
FundService ..> ReimbursementResponse : reserves pending and disburses approved
FundService ..> FundTransactionResponse : appends immutable IN/OUT/REVERSAL ledger
UserEntity "1" -- "0..*" MessageReactionEntity
UserEntity "1" -- "0..*" ConversationReadStateEntity
ChatService ..> ChatRealtimeTransactionalBridge : publishes AFTER_COMMIT domain events
ChatRealtimeTransactionalBridge --> ChatRealtimeCoordinator : dispatches committed chat events
ChatWebSocketConfig --> ChatWebSocketHandler : registers /ws, /api/v1/ws
ChatWebSocketConfig --> ChatWebSocketHandshakeInterceptor : enforces JWT handshake
ChatWebSocketHandler --> ChatRealtimeCoordinator : manages sessions, typing, presence
NotificationController --> NotificationService
NotificationDomainEventListener --> NotificationService : AFTER_COMMIT inbox + push dispatch
class PostCommitDelivery
ChatRealtimeTransactionalBridge --> PostCommitDelivery : bounded post-commit enqueue
NotificationDomainEventListener --> PostCommitDelivery : isolated inbox work
NotificationService --> PostCommitDelivery : separate bounded push workers
NotificationService ..> NotificationDomainEvent : deduplicates by eventKey
NotificationService ..> NotificationItemResponse : persists inbox and resolves target actionability
NotificationService ..> UserNotificationSettingsResponse : evaluates category push policy
NotificationService ..> GroupNotificationSettingsResponse : evaluates server-side muteUntil and critical bypass
NotificationService ..> UserDeviceResponse : registers/deactivates device push tokens
NotificationService --> PushGateway : dispatches push outside DB transaction
NotificationService --> ChatRealtimeCoordinator : suppresses push on open conversation
FcmPushGateway ..|> PushGateway : isolates provider errors and invalid tokens
package "Private Group Memories (R4 / V15)" {
  class MomentController
  class MomentService
  class GroupMoment <<group_moments>> {
    id : UUID
    groupId : UUID
    activityId : UUID?
    createdBy : UUID
    caption : String
    deletedAt : Instant?
  }
  class MomentMedia <<moment_media>> {
    id : UUID
    storageKey : String [private]
    contentType : String
    fileSize : long
    sortOrder : int
  }
  class MomentReaction <<moment_reactions>>
  class MomentComment <<moment_comments>>
  class GroupAlbum <<group_albums>>
  class AlbumItem <<album_items>>
  MomentController --> MomentService
  MomentService --> GroupPermissionService : current membership
  MomentService --> MediaReferenceService : uploader/group/metadata
  MomentService --> ObjectStorageService : private signed GET (60 seconds)
  MomentService --> RealtimePublisher : group hint AFTER_COMMIT
  GroupEntity "1" -- "0..*" GroupMoment
  ActivityEntity "0..1" -- "0..*" GroupMoment : same group
  GroupMoment "1" -- "0..*" MomentMedia
  GroupMoment "1" -- "0..*" MomentReaction : unique user
  GroupMoment "1" -- "0..*" MomentComment
  GroupEntity "1" -- "0..*" GroupAlbum
  ActivityEntity "0..1" -- "0..*" GroupAlbum : same group
  GroupAlbum "1" -- "0..*" AlbumItem
  MomentMedia "1" -- "0..*" AlbumItem : no byte copy
}
package "Community Core (R5 / V16)" {
  class CommunityController
  class CommunityService
  class CommunityAccess {
    canRead(postId, viewerId) : boolean
    ELIGIBLE : shared SQL predicate
  }
  class CommunityPost <<community_posts>> {
    id : UUID
    authorId : UUID
    postType : GENERAL | LOOKING_FOR_MEMBERS
    visibility : PUBLIC | FRIENDS_OF_FRIENDS | FRIENDS | GROUP_ONLY
    groupId : UUID?
    moderationStatus : ACTIVE | REMOVED
    deletedAt : Instant?
  }
  class CommunityMedia <<community_media>>
  class CommunityReaction <<community_reactions>>
  class CommunityComment <<community_comments>>
  class CommunityHiddenPost <<community_hidden_posts>>
  class CommunityReport <<community_reports>> {
    targetType : POST | COMMENT | USER
    reason : SPAM | HARASSMENT | INAPPROPRIATE_CONTENT | SCAM | OTHER
    status : OPEN | REVIEWED | DISMISSED
    reporterId : UUID (private)
    evidence : String (reviewer only)
  }
  class CommunityModerator <<community_moderators>> {
    userId : UUID
    grantedAt : Instant
    grantedBy : UUID
    revokedAt : Instant?
  }
  class CommunityModerationAction <<community_moderation_actions>> {
    id : UUID (command receipt)
    moderatorId : UUID
    action : DISMISS | RESOLVE | REMOVE | RESTORE
    reason : String
    createdAt : Instant
  }
  class ModerationController
  class ModerationService
  ModerationController --> ModerationService
  ModerationService --> CommunityAccess : ordinary submission eligibility
  ModerationService --> CommunityModerator : explicit global role
  ModerationService --> GroupMembershipEntity : GROUP_ONLY reviewer
  ModerationService --> RealtimePublisher : AFTER_COMMIT
  ModerationService --> ObjectStorageService : exact report signed evidence
  RealtimeScopeAccess --> ModerationService : scope + report delivery check
  CommunityReport "1" -- "0..*" CommunityModerationAction
  CommunityReport --> UserEntity : private reporter / USER target
  CommunityReport --> CommunityComment : optional COMMENT target
  CommunityModerator --> UserEntity
  CommunityModerationAction --> UserEntity : reviewer
  CommunityController --> CommunityService
  CommunityService --> CommunityAccess : shared authorization
  RealtimeScopeAccess --> CommunityAccess : post delivery predicate
  CommunityService --> MediaReferenceService : uploader UUID context
  CommunityService --> ObjectStorageService : private signed GET
  CommunityService --> RealtimePublisher : AFTER_COMMIT
  UserEntity "1" -- "0..*" CommunityPost
  GroupEntity "0..1" -- "0..*" CommunityPost : GROUP_ONLY
  CommunityPost "1" -- "0..*" CommunityMedia
  CommunityPost "1" -- "0..*" CommunityReaction
  CommunityPost "1" -- "0..*" CommunityComment
  CommunityPost "1" -- "0..*" CommunityHiddenPost
  CommunityPost "0..1" -- "0..*" CommunityReport
}
package "R6 Recruitment + canonical admission" {
  class RecruitmentController
  class RecruitmentService
  class RecruitmentProjection
  class RecruitmentAdmissionGuard
  class RecruitmentEvents
  class CommunityRecruitment <<community_recruitment>>
  class RecruitmentApplication <<recruitment_applications>>
  RecruitmentController --> RecruitmentService
  RecruitmentService --> CommunityService : canonical post
  RecruitmentService --> GroupAdmissionService : pending / approve / reject / cancel
  RecruitmentService --> RecruitmentProjection : safe snapshot + status
  GroupAdmissionService --> RecruitmentAdmissionGuard : provenance quota under locks
  RecruitmentAdmissionGuard --> RecruitmentProjection
  RealtimeScopeAccess --> RecruitmentProjection : manager review scope
  RecruitmentEvents --> RealtimePublisher : existing AFTER_COMMIT
  CommunityPost "1" -- "0..1" CommunityRecruitment
  GroupEntity "1" -- "0..*" CommunityRecruitment
  ActivityEntity "0..1" -- "0..*" CommunityRecruitment
  CommunityRecruitment "1" -- "0..*" RecruitmentApplication
  RecruitmentApplication --> GroupJoinRequestEntity : provenance only
}
package "R10 Journey / evidence / explicit actions" {
  class ActivityStop
  class ActivityStopCheckin
  class TaskExecution
  class TaskEvidence
  class TaskEvidenceMedia
  class TaskEvidenceReview
  class PollConversionLink
  ActivityEntity "1" -- "0..*" ActivityStop
  ActivityStop "1" -- "0..*" ActivityStopCheckin
  ActivityStopCheckin --> GroupMoment : canonical Moment FK
  TaskExecution --> ActivityStop : optional same Activity
  TaskEntity "1" -- "0..1" TaskExecution
  TaskEntity "1" -- "0..*" TaskEvidence
  TaskEvidence "1" -- "1..*" TaskEvidenceMedia
  TaskEvidence "1" -- "0..1" TaskEvidenceReview
  PollConversionLink --> ActivityStop : STOP target
  PollConversionLink --> TaskEntity : TASK target
  PollConversionLink --> PollEntity : optional source
  PollConversionLink --> PollOptionEntity : optional option
  note right of PollConversionLink
    UUID + option/kind/Activity dedupe
    retained source snapshots
  end note
}
@enduml
