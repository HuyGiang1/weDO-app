# Template only. scripts/teammate-env.ps1 -Initialize generates private values.
# No actual passwords, signing keys, Firebase Admin keys or APNs material here.
SPRING_PROFILES_ACTIVE=local,teammate
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
WEDO_DB_URL=jdbc:postgresql://127.0.0.1:15432/wedo
WEDO_DB_USERNAME=wedo
WEDO_DB_PASSWORD=GENERATE_LOCALLY
WEDO_REDIS_HOST=127.0.0.1
WEDO_REDIS_PORT=16379
WEDO_JWT_SECRET_BASE64=GENERATE_LOCALLY
WEDO_AUTH_TOKEN_PEPPER_BASE64=GENERATE_LOCALLY
WEDO_PROFILE_COMPLETION_TOKEN_SECRET_BASE64=GENERATE_LOCALLY
WEDO_MEDIA_S3_ENDPOINT=http://127.0.0.1:19000
WEDO_MEDIA_PUBLIC_ENDPOINT=http://10.0.2.2:19000
WEDO_MEDIA_BUCKET=wedo-media
WEDO_MEDIA_REGION=us-east-1
WEDO_MEDIA_ACCESS_KEY=GENERATE_LOCALLY
WEDO_MEDIA_SECRET_KEY=GENERATE_LOCALLY
# Core-only start: media/OS push unavailable until configured explicitly.
WEDO_MEDIA_BOOTSTRAP_BUCKET=false
WEDO_PUSH_ENABLED=false
WEDO_LOCAL_TEST_DATA_ENABLED=true
WEDO_LOCAL_TEST_PASSWORD=GENERATE_LOCALLY
# Optional licensed media profile; use an absolute forward-slash Windows path.
WEDO_AISTOR_LICENSE_PATH=
